# Source APIs
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=

# X (Twitter) sourcing via twitterapi.io — replaces the official X Bearer Token.
# Sign up at https://twitterapi.io and paste your API key here.
TWITTERAPI_IO_KEY=

# OpenAI
OPENAI_API_KEY=

# ---------------------------------------------------------------------------
# Piper TTS (optional — leave unset to use a silent WAV stub instead)
#
# PIPER_EXE        Full path to the piper executable (piper.exe on Windows).
# PIPER_VOICES_DIR Folder that contains your *.onnx voice model files.
# PIPER_VOICE      Voice basename WITHOUT the .onnx extension.
#                  Default: en_GB-northern_english_male-medium
#
# Example paths for this machine:
# PIPER_EXE=C:\Users\xavie\OneDrive\Documents\piper\piper.exe
# PIPER_VOICES_DIR=C:\Users\xavie\OneDrive\Documents\piper\voices
# PIPER_VOICE=en_GB-northern_english_male-medium
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# ffmpeg rendering options (optional — defaults shown)
#
# FFMPEG_TIMEOUT   Seconds to wait for ffmpeg before aborting (default: 300).
#                  Increase if rendering large/long videos on a slow machine.
# FFMPEG_VERBOSE   Set to 1 to stream full ffmpeg output to the console.
#                  Useful for diagnosing hangs or codec errors.
#
# FFMPEG_TIMEOUT=300
# FFMPEG_VERBOSE=0
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Production tuning (optional)
#
# BACKGROUND_SAFETY_BUFFER_SECONDS   Extra background timeline added beyond
#                                    audio duration before final trim.
#                                    Default: 0.75
# BACKGROUND_RANDOMIZE               1 (default) picks random clips each run.
# BACKGROUND_RANDOM_SEED             Optional fixed seed for reproducible picks.
# BACKGROUND_ALLOW_IMMEDIATE_REPEATS 0 (default) avoids back-to-back duplicates
#                                    when other clips are available.
# CAPTION_STYLE_MODE                 "active_word" (default) or "plain"
# CAPTION_ACTIVE_WORD_COLOR          ASS colour used for the active word.
#                                    Default: &H0038FF&
# SEPARATE_CAPTION_TTS_REWRITE       1 (default) keeps caption/TTS scripts
#                                    separate when available.
# VOICE_PROFILE                      Placeholder for voice profile selection;
#                                    currently used as fallback for PIPER_VOICE.
# OPENAI_REWRITE_BATCH_SIZE          Max posts per rewrite request (default: 5).
#
# BACKGROUND_SAFETY_BUFFER_SECONDS=0.75
# BACKGROUND_RANDOMIZE=1
# BACKGROUND_RANDOM_SEED=
# BACKGROUND_ALLOW_IMMEDIATE_REPEATS=0
# CAPTION_STYLE_MODE=active_word
# CAPTION_ACTIVE_WORD_COLOR=&H0038FF&
# SEPARATE_CAPTION_TTS_REWRITE=1
# VOICE_PROFILE=en_GB-northern_english_male-medium
# OPENAI_REWRITE_BATCH_SIZE=5
# ---------------------------------------------------------------------------
